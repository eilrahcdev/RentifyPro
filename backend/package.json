{
  "name": "rentifypro-backend",
  "version": "1.0.0",
  "description": "RentifyPro Backend API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "kyc:ocr:dev": "node scripts/start-private-ocr.js",
    "test": "node --test tests/*.test.js",
    "db:check": "node scripts/check-mongo-connection.js",
    "db:migrate:kyc": "node scripts/migrate-kyc-collections.js",
    "db:migrate:notifications": "node scripts/migrate-notifications.js",
    "db:migrate:reports": "node scripts/migrate-report-indexes.js",
    "db:migrate:session-revocations": "node scripts/migrate-session-revocation-indexes.js",
    "db:migrate:payments": "node scripts/migrate-payment-indexes.js",
    "db:migrate:local": "node scripts/migrate-mongo-to-local.js",
    "db:migrate:atlas": "node scripts/migrate-local-to-atlas.js",
    "services:check": "node scripts/check-external-services.js",
    "chatbot:assets:sync": "node scripts/sync-chatbot-assets.js",
    "chatbot:assets:check": "node scripts/sync-chatbot-assets.js --check",
    "production:check": "node scripts/check-production-readiness.js",
    "test:payment-mongo": "node scripts/check-payment-mongo.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": "24.19.0"
  }
}
