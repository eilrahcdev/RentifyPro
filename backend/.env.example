# Use a local MongoDB server, or replace this with your private Atlas URI.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/rentifypro
MONGO_URI_DIRECT=
MONGO_DB_NAME=rentifypro

# Fill these locally with private values. Never commit the populated .env.
JWT_SECRET=
PASSWORD_RESET_TOKEN_SECRET=
INTERNAL_API_KEY=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Production only: confirm the key's billing-enabled project and applicable data terms first.
GEMINI_SENSITIVE_DATA_APPROVED=false

JWT_EXPIRE=7d
PASSWORD_RESET_TOKEN_EXPIRE=15m
FRONTEND_URL=http://localhost:5173
ALLOW_VERCEL_PREVIEW_ORIGINS=false
# Set these for a Quick Tunnel session using its exact current HTTPS URL.
BACKEND_PUBLIC_URL=
SERVE_FRONTEND_DIST=false
FACE_SERVICE_URL=http://localhost:8000
CHATBOT_URL=http://localhost:8001
FACE_SERVICE_AUTOSTART=true
CHATBOT_SERVICE_AUTOSTART=true

# Keep document decisions subject to administrator review.
KYC_DOCUMENT_QUEUE_ENABLED=true
KYC_ALLOW_GEMINI_AUTO_APPROVE=false
# Maximum wait for one Gemini document request; temporary failures retain bounded retries.
KYC_GEMINI_REQUEST_TIMEOUT_MS=30000

# Optional for local development; required in production on a mounted persistent volume.
# All public media and private KYC/report/vehicle-photo files then live under this root.
STORAGE_ROOT=
STORAGE_DURABILITY_CONFIRMED=false
MONGO_AUTO_INDEX=false

# Use private test keys in development/staging and live keys for real payments.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ALLOW_TEST_MODE=false
PAYMENT_RECONCILIATION_ENABLED=true

# Configure these locally if registration email or OTP delivery is needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=RentifyPro
