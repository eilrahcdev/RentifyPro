# Current backend environment template. See ENVIRONMENT.md for the audit and Azure checklist.
# Copy to .env only on a new setup; preserve an existing populated .env.
# Blank secrets must be supplied privately. Azure production settings override local defaults.

# Runtime
# Development fallback only; the server always respects the platform's PORT.
PORT=5000
NODE_ENV=development
# Production always enables rate limiting regardless of this development switch.
ENABLE_RATE_LIMIT=false
# Existing proxy default; configure for the actual trusted proxy chain.
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
KYC_JSON_BODY_LIMIT=8mb

# MongoDB
# Safe local connection. Replace privately for Atlas; never commit populated URIs.
# MONGO_URI_DIRECT takes precedence when supplied; at least one URI is required.
MONGO_URI=mongodb://127.0.0.1:27017/rentifypro
MONGO_URI_DIRECT=
MONGO_DB_NAME=rentifypro
# Required false in production; use the explicit index migrations.
MONGO_AUTO_INDEX=false
MONGO_CONNECT_RETRIES=5
MONGO_RETRY_DELAY_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000

# Authentication
# JWT_SECRET is required for authentication; production requires at least 32 private random characters.
JWT_SECRET=
JWT_EXPIRE=7d
# Optional dedicated signing secrets; blank values use JWT_SECRET.
PASSWORD_RESET_TOKEN_SECRET=
PASSWORD_RESET_TOKEN_EXPIRE=15m
PRE_KYC_SESSION_SECRET=
PRE_KYC_SESSION_TTL=20m
PRE_KYC_SESSION_MAX_RENEWAL_HOURS=72
OTP_RESEND_COOLDOWN_SECONDS=45
LOGIN_CHALLENGE_TTL_MINUTES=180
LOGIN_CHALLENGE_MAX_ATTEMPTS=5
AVATAR_MAX_BYTES=2097152
# Optional audit identifier hashing secret; uses JWT_SECRET, then a development-only local key.
LOG_HASH_SECRET=

# Frontend / CORS
# Comma-separated origins. Production requires exact owned HTTPS origins without wildcards.
FRONTEND_URL=http://localhost:5173
ALLOW_VERCEL_PREVIEW_ORIGINS=false
# Production requires the backend's public HTTPS URL; development can derive request URLs.
BACKEND_PUBLIC_URL=
SERVE_FRONTEND_DIST=false

# External services
# Local Face Service uses 8010; local Chatbot Service uses 8001.
# Production requires the deployed HTTPS URLs and both autostart switches set to false.
FACE_SERVICE_URL=http://localhost:8010
CHATBOT_URL=http://localhost:8001
# Shared private key must match the Face Service; production requires at least 32 characters.
INTERNAL_API_KEY=
FACE_SERVICE_AUTOSTART=true
CHATBOT_SERVICE_AUTOSTART=true
# Local launch and health-check tuning; blank interpreter/entry overrides use bundled/system defaults.
FACE_SERVICE_ENTRY=
FACE_SERVICE_PYTHON_BIN=
FACE_SERVICE_STARTUP_TIMEOUT_MS=90000
FACE_SERVICE_HEALTH_TIMEOUT_MS=2500
FACE_SERVICE_HEALTH_POLL_MS=1500
CHATBOT_SERVICE_PYTHON_BIN=
CHATBOT_SERVICE_RELOAD=false
CHATBOT_SERVICE_STARTUP_TIMEOUT_MS=180000
CHATBOT_SERVICE_HEALTH_TIMEOUT_MS=3000
CHATBOT_SERVICE_HEALTH_POLL_MS=2000
# Forwarded to a locally spawned Face Service.
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2

# KYC / Gemini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Optional vehicle-photo model override; blank inherits GEMINI_VISION_MODEL.
GEMINI_VEHICLE_PHOTO_MODEL=
# Production requires true only after confirming the key's billing and sensitive-data terms.
GEMINI_SENSITIVE_DATA_APPROVED=false
KYC_DOCUMENT_QUEUE_ENABLED=true
# Canonical automatic-verification switch. Blank inherits the legacy switch below (default false).
# This is document screening configuration; final account approval still requires administrator review.
KYC_ALLOW_RULE_BASED_AUTO_VERIFY=
# Compatibility alias, read only when the canonical switch is blank/unset.
KYC_ALLOW_GEMINI_AUTO_APPROVE=false
# Canonical confidence threshold; a nonempty canonical value takes precedence over the alias.
KYC_DOCUMENT_AUTO_VERIFY_MIN_CONFIDENCE=85
KYC_DOCUMENT_AUTO_APPROVE_MIN_CONFIDENCE=
KYC_DOCUMENT_CLASSIFICATION_MIN_CONFIDENCE=90
# Optional document fingerprint secret; blank uses JWT_SECRET.
KYC_DOCUMENT_FINGERPRINT_SECRET=
KYC_GEMINI_REQUEST_TIMEOUT_MS=30000
KYC_GEMINI_MAX_ATTEMPTS=3
KYC_GEMINI_REQUESTS_PER_MINUTE=4
KYC_DOCUMENT_QUEUE_POLL_MS=5000
KYC_PROCESSING_LOCK_TIMEOUT_MS=600000
KYC_DOC_MAX_BYTES=4194304
KYC_IMAGE_MAX_BYTES=4194304
PREKYC_DOC_TTL_HOURS=3
# Blank inherits PREKYC_DOC_TTL_HOURS (default 3).
PREKYC_FACE_TTL_HOURS=
PREKYC_CLEAR_ON_REGISTER=false
KYC_FILE_RETENTION_HOURS=3
KYC_PENDING_REVIEW_RETENTION_HOURS=72
KYC_FILE_CLEANUP_INTERVAL_MS=900000

# Storage
# Optional locally. Production requires an absolute mounted persistent root and confirmed durability.
# Azure production: STORAGE_ROOT=/mounts/rentifypro and STORAGE_DURABILITY_CONFIRMED=true.
# Public uploads and private KYC/report/vehicle-photo directories are derived from this root.
STORAGE_ROOT=
STORAGE_DURABILITY_CONFIRMED=false
# Optional directory overrides. In production keep public/private paths separate inside STORAGE_ROOT.
PUBLIC_UPLOAD_DIR=
AVATAR_UPLOAD_DIR=
KYC_UPLOAD_DIR=
REPORT_EVIDENCE_DIR=
# Optional website-backend directory for admin media lookup; blank uses this backend.
WEBSITE_BACKEND_DIR=

# PayMongo
# Supply private test keys for development; production requires live keys or explicit staging test mode.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ALLOW_TEST_MODE=false
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card
# Defaults to enabled and must remain enabled in production.
PAYMENT_RECONCILIATION_ENABLED=true

# Email / SMTP
# SMTP_* is canonical. A blank SMTP_USER/SMTP_PASS falls back to its matching EMAIL_* field.
# Configure a complete credential pair from one provider; avoid mixing canonical and legacy credentials.
# SMTP_HOST enables host/port/secure transport; blank uses SMTP_SERVICE (default gmail).
SMTP_HOST=
SMTP_SERVICE=gmail
# Host transport: 587 with secure=false, or configure 465 with secure=true.
# Host/port/secure settings are ignored when using the service preset.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Legacy credential aliases retained for existing local setups.
EMAIL_USER=
EMAIL_PASS=
# Blank sender address inherits SMTP_USER, then EMAIL_USER.
EMAIL_FROM=
EMAIL_FROM_NAME=RentifyPro
# Optional development troubleshooting only; keep false to verify SMTP TLS certificates.
SMTP_TLS_INSECURE=false

# Notifications / audit logs
# Opt-in notification delivery; registration/OTP mail remains independent of this switch.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_DELIVERY_INTERVAL_MS=60000
NOTIFICATION_CLEANUP_INTERVAL_MS=3600000
READ_NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_ARCHIVE_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=30

# Booking configuration
# Do not leave the fee blank: Number("") would select zero instead of the supported default of 140 PHP.
BOOKING_TRANSACTION_FEE=140
BOOKING_LIFECYCLE_INTERVAL_MS=60000
# Late-return charges are configured by the owner per vehicle; an unconfigured fee is zero.
BOOKING_OVERDUE_GRACE_MINUTES=0

# Optional maintenance / diagnostic scripts (not required for API startup)
# Local database migration source/destination; blank name inherits MONGO_DB_NAME.
# The local-to-Atlas script reads these from backend/.env directly.
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017
MONGO_LOCAL_DB_NAME=
# Used only when migrating legacy KYC biometric templates.
BIOMETRIC_TEMPLATE_TTL_HOURS=24
# Used only by manual `node test-email.js`, which sends a real email; blank uses the SMTP login address.
TEST_EMAIL_TO=
