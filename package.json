{
  "name": "rentifypro-admin",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "storage:check": "node backend/scripts/checkStorage.js",
    "storage:connect-azure": "node backend/scripts/connectAzureKyc.js",
    "admin:sync-credentials": "node backend/scripts/syncAdminCredentials.js",
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "start": "npm run start --workspace backend"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
